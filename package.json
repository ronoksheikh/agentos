{
  "name": "agentos",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "db:generate": "drizzle-kit generate",
    "db:phase4-smoke": "bun scripts/phase4-db-smoke.ts",
    "db:phase5-smoke": "bun scripts/phase5-integration.ts",
    "db:phase5-restart": "bun scripts/phase5-restart-check.ts",
    "db:phase7-retention": "bun scripts/phase7-retention-integration.ts",
    "db:phase7-offboard-prepare": "bun scripts/phase7-offboard-integration.ts prepare",
    "db:phase7-offboard-verify": "bun scripts/phase7-offboard-integration.ts verify",
    "db:phase7-evaluations": "bun scripts/phase7-evaluations-integration.ts",
    "db:phase7-retention-policy": "bun scripts/phase7-retention-policy-integration.ts",
    "db:phase6-messenger": "bun scripts/phase6-messenger-integration.ts",
    "db:migrate": "drizzle-kit migrate",
    "admin:dev": "next dev apps/admin",
    "admin:build": "next build apps/admin",
    "client:dev": "next dev apps/client -p 3001",
    "client:build": "next build apps/client",
    "worker:start": "bun apps/worker/src/index.ts",
    "browser-egress:start": "bun apps/browser-egress/src/index.ts"
  },
  "dependencies": {
    "@mantine/core": "^8",
    "@mantine/form": "^8",
    "@mantine/hooks": "^8",
    "@mantine/notifications": "^8",
    "better-auth": "^1.3.8",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.3",
    "next": "^15",
    "openai": "^7.22.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19",
    "react-dom": "^19",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3"
  }
}
