{
  "name": "agentos",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:dev": "next dev apps/admin",
    "admin:build": "next build apps/admin",
    "client:dev": "next dev apps/client -p 3001",
    "client:build": "next build apps/client"
  },
  "dependencies": {
    "@mantine/core": "^8",
    "@mantine/form": "^8",
    "@mantine/hooks": "^8",
    "@mantine/notifications": "^8",
    "better-auth": "^1.3.8",
    "drizzle-orm": "^0.44.5",
    "mammoth": "^1.12.3",
    "next": "^15",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19",
    "react-dom": "^19",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3"
  }
}
