DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
CLIENT_BETTER_AUTH_URL=http://localhost:3001
AUTH_EMAIL_WEBHOOK_URL=https://mail-gateway.example.internal/send
VISITOR_SESSION_SECRET=replace-with-at-least-32-random-characters
META_APP_ID=your-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_OAUTH_REDIRECT_URI=https://your-domain.example/api/meta/oauth/callback
META_WEBHOOK_CALLBACK_URL=https://your-domain.example/api/webhooks/meta/messenger
META_WEBHOOK_VERIFY_TOKEN=replace-with-random-verification-token
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
CREDENTIAL_KEY_VERSION=v1
META_MEDIA_ALLOWED_HOSTS=scontent.xx.fbcdn.net
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_VISION_MODEL=your-approved-vision-model
PRIVATE_MEDIA_DIR=/var/lib/agentos/private-media
PUBLIC_MEDIA_BASE_URL=https://your-domain.example
MEDIA_SIGNING_KEY=replace-with-at-least-32-random-characters
BROWSER_WORKER_URL=http://127.0.0.1:4317
BROWSER_WORKER_TOKEN=replace-with-at-least-24-random-characters
BROWSER_EGRESS_TOKEN=replace-with-at-least-24-random-characters
